@page "/players"
@model PlayersModel
@{
    ViewData["Title"] = "Players";
    ViewData["Nav"] = "players";
}
<h1 class="title">@T["Players_Title"]</h1>

<form class="search" method="get" action="/players" role="search">
    <input name="q" value="@Model.Q" placeholder="@T["Search_Placeholder"]" maxlength="32" aria-label="Player name">
    <button type="submit" class="secondary">@T["Search_Button"]</button>
</form>

<section class="panel">
    @if (Model.List.Count == 0)
    {
        <p class="empty" style="padding: 16px;">@(string.IsNullOrWhiteSpace(Model.Q) ? T["Players_NoActive"] : T["Players_NoMatch"])</p>
    }
    else
    {
        <div class="scroll">
            <table class="list">
                <thead>
                <tr>
                    <th>@T["Col_Player"]</th>
                    @if (Model.Ranked) { <th>@T["Col_Division"]</th><th class="num">@T["Col_Rating"]</th> }
                    <th class="num">@T["Col_MatchesShort"]</th><th class="num">@T["Col_Record"]</th><th class="num">@T["Col_WinRate"]</th><th>@T["Col_LastPlayed"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.List)
                {
                    <tr>
                        <td>
                            @if (Model.Online.Contains(p.Pid)) { <span class="online" title="Online"></span> }<a href="/players/@p.Pid">@p.Name</a>
                            <span class="platform-badges">
                                @{
                                    var plat = p.Account?.Platforms ?? "PC";
                                }
                                @if (plat.Contains("PC", StringComparison.OrdinalIgnoreCase))
                                {
                                    <img src="/img/pc.png" alt="PC" title="PC" class="platform-icon" />
                                }
                                @if (plat.Contains("PS3", StringComparison.OrdinalIgnoreCase))
                                {
                                    <img src="/img/ps3_white.png" alt="PS3" title="PS3" class="platform-icon" />
                                }
                            </span>
                        </td>
                        @if (Model.Ranked)
                        {
                            <td><span class="div @p.Division">@p.Division</span></td>
                            <td class="num score">@p.Rating</td>
                        }
                        <td class="num">@p.Stats.MatchCount</td>
                        <td class="num">@p.Stats.WinCount–@p.Stats.DrawCount–@p.Stats.LoseCount</td>
                        <td class="num">@SiteData.WinPercent(p.Stats.WinCount, p.Stats.MatchCount)</td>
                        <td class="muted">@(p.LastPlayedAt is { } at ? SiteData.Date(at) : "–")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.PendingAccounts.Count > 0)
{
    <h3 style="font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 24px 0 10px;">@T["Players_RegisteredMembers"]</h3>
    <section class="panel">
        <div class="scroll">
            <table class="list">
                <thead>
                <tr>
                    <th>Game ID</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var acc in Model.PendingAccounts)
                {
                    <tr>
                        <td>
                            <strong><a href="/players/@acc.GameId">@acc.GameId</a></strong>
                            <span class="platform-badges">
                                @if ((acc.Platforms ?? "PC").Contains("PC", StringComparison.OrdinalIgnoreCase))
                                {
                                    <img src="/img/pc.png" alt="PC" title="PC" class="platform-icon" />
                                }
                                @if ((acc.Platforms ?? "").Contains("PS3", StringComparison.OrdinalIgnoreCase))
                                {
                                    <img src="/img/ps3_white.png" alt="PS3" title="PS3" class="platform-icon" />
                                }
                            </span>
                        </td>
                        <td><span class="tag lime">@T["Players_ReadyToPlay"]</span></td>
                        <td class="muted">@acc.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a href="/players/@acc.GameId" class="button small secondary" style="padding: 3px 10px; font-size: 11px;">@T["Players_ViewProfile"]</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
<partial name="_Pager" model="Model.Pager" />
