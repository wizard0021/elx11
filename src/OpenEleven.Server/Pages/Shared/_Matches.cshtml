@model IReadOnlyList<MatchRow>
@if (Model.Count == 0)
{
    <p class="empty">@T["Panel_NoMatches"]</p>
}
else
{
    <div class="scroll">
        <table class="list">
            <thead><tr><th>@T["Col_Date"]</th><th class="num">@T["Col_Home"]</th><th class="center">@T["Col_Score"]</th><th>@T["Col_Away"]</th><th></th></tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                var m = row.Match;
                <tr>
                    <td class="muted"><span class="long">@SiteData.Date(m.PlayedAt)</span><span class="short">@SiteData.ShortDate(m.PlayedAt)</span></td>
                    <td class="num"><a href="/players/@m.HomePid">@row.Home</a></td>
                    <td class="center"><button type="button" class="scorebutton" popovertarget="match-@m.Id" title="Match details">@m.HomeScore &ndash; @m.AwayScore</button></td>
                    <td><a href="/players/@m.AwayPid">@row.Away</a></td>
                    <td>
                        @if (m.Ranked) { <span class="tag lime">@T["Tag_Ranked"]</span> }
                        @if (m.ExtraTime) { <span class="tag">@T["Tag_ExtraTime"]</span> }
                        @if (m.Penalties) { <span class="tag">@T["Tag_Penalties"]</span> }
                        @if (m.Disconnected) { <span class="tag red">@T["Tag_Disconnect"]</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @foreach (var row in Model)
    {
        <partial name="_MatchDetail" model="row" />
    }
}
