@using OpenEleven.Server.Configuration
@inject GameProfile Game
@{
    var title = TitleProfiles.DisplayName(Game);
    var name = title.Split(' ');   // "PES", "2011", "(PC)"
    var nav = ViewData["Nav"] as string;
    var admin = nav is not null && nav.StartsWith("admin", StringComparison.Ordinal) && nav != "admin-login";
    string? Current(string item) => nav == item ? "page" : null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string page ? $"{page} · ELX11 {title}" : $"ELX11 · Evolution Legacy X 11 · {title} online")</title>
    @* The version hash changes the URL whenever the file does, so no browser keeps an old copy. *@
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" asp-append-version="true"></head>
<body>
<header class="topbar">
    <div class="inner">
        @* On phones the nav folds into a native popover behind this button; no script. *@
        <button type="button" class="burger" popovertarget="menu" aria-label="Menu"></button>
        <a class="brand" href="/">
            <img src="/img/logoalternative_crop.png" alt="ELX11 - Evolution Legacy X 11" class="brand-logo" />
        </a>
        <nav class="nav" id="menu" popover>
            @if (admin)
            {
                <a href="/admin" aria-current="@Current("admin")">Online</a>
                <a href="/admin/accounts" aria-current="@Current("admin-accounts")">Accounts</a>
                <a href="/admin/news" aria-current="@Current("admin-news")">News</a>
                <a href="/admin/lobbies" aria-current="@Current("admin-lobbies")">Lobbies</a>
                <a href="/admin/words" aria-current="@Current("admin-words")">Words</a>
                <a href="/admin/settings" aria-current="@Current("admin-settings")">Settings</a>
                <a href="/">Site</a>
                <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout" class="inline"><button type="submit" class="small secondary">Sign out</button></form>
            }
            else
            {
                <a href="/" aria-current="@Current("home")">Home</a>
                <a href="/rankings" aria-current="@Current("rankings")">Rankings</a>
                <a href="/players" aria-current="@Current("players")">Players</a>
                <a href="/matches" aria-current="@Current("matches")">Matches</a>
                <a href="/survey" aria-current="@Current("survey")">Hardware Survey</a>
                <a href="/#roadmap">Roadmap</a>
                <a href="/register" aria-current="@Current("register")">Register</a>
            }
        </nav>
    </div>
</header>
<main class="page">
    @RenderBody()
</main>
<footer class="bottombar">
    <div class="inner">
        <span>ELX11 (Evolution Legacy X 11) &middot; a fan-run community server for @title &middot; Powered by OpenEleven</span>
        <span class="hints">
            <a href="/survey"><i class="dot blue"></i>Hardware Survey</a>
            <a href="/#roadmap"><i class="dot yellow"></i>Roadmap</a>
            <a href="/register"><i class="dot green"></i>Create account</a>
            <a href="#"><i class="dot red"></i>Back to top</a>
        </span>
    </div>
</footer>
@if (ViewData["Live"] is true)
{
    <script src="/js/live.js" asp-append-version="true" defer></script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
