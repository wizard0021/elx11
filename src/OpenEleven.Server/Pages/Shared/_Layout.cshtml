@using OpenEleven.Server.Configuration
@inject GameProfile Game
@{
    var title = TitleProfiles.DisplayName(Game);
    var name = title.Split(' ');   // "PES", "2011", "(PC)"
    var nav = ViewData["Nav"] as string;
    var admin = nav is not null && nav.StartsWith("admin", StringComparison.Ordinal) && nav != "admin-login";
    string? Current(string item) => nav == item ? "page" : null;
}
<!doctype html>
<html lang="@T.CurrentCulture">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string page ? $"{page} · ELX11 {title}" : $"ELX11 · Evolution Legacy X 11 · {title} online")</title>
    @* The version hash changes the URL whenever the file does, so no browser keeps an old copy. *@
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" asp-append-version="true"></head>
<body>
<header class="topbar">
    <div class="inner">
        @* On phones the nav folds into a native popover behind this button; no script. *@
        <button type="button" class="burger" popovertarget="menu" aria-label="Menu"></button>
        <a class="brand" href="/">
            <img src="/img/logoalternative_crop.png" alt="ELX11 - Evolution Legacy X 11" class="brand-logo" />
        </a>
        <nav class="nav" id="menu" popover>
            @if (admin)
            {
                <a href="/admin" aria-current="@Current("admin")">Online</a>
                <a href="/admin/accounts" aria-current="@Current("admin-accounts")">Accounts</a>
                <a href="/admin/news" aria-current="@Current("admin-news")">News</a>
                <a href="/admin/lobbies" aria-current="@Current("admin-lobbies")">Lobbies</a>
                <a href="/admin/words" aria-current="@Current("admin-words")">Words</a>
                <a href="/admin/settings" aria-current="@Current("admin-settings")">Settings</a>
                <a href="/">@T["Nav_Site"]</a>
                <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout" class="inline"><button type="submit" class="small secondary">@T["Nav_SignOut"]</button></form>
            }
            else
            {
                <a href="/" aria-current="@Current("home")">@T["Nav_Home"]</a>
                <a href="/rankings" aria-current="@Current("rankings")">@T["Nav_Rankings"]</a>
                <a href="/players" aria-current="@Current("players")">@T["Nav_Players"]</a>
                <a href="/matches" aria-current="@Current("matches")">@T["Nav_Matches"]</a>
                <a href="/survey" aria-current="@Current("survey")">@T["Nav_HardwareSurvey"]</a>
                <a href="/#roadmap">@T["Nav_Roadmap"]</a>
                <a href="/register" aria-current="@Current("register")">@T["Nav_Register"]</a>
            }
        </nav>
        <div class="lang-selector">
            <button type="button" class="lang-trigger" aria-haspopup="listbox" aria-expanded="false" id="langBtn" onclick="toggleLangMenu(event)" title="@T["Lang_Select"]">
                <span class="lang-current-flag">@T.CurrentLanguage.Flag</span>
                <span class="lang-current-code">@T.CurrentLanguage.Code.ToUpperInvariant()</span>
                <span class="lang-caret">▾</span>
            </button>
            <div class="lang-menu" id="langMenu">
                @foreach (var lang in T.SupportedLanguages)
                {
                    <a href="javascript:void(0)" class="lang-option @(lang.Code == T.CurrentCulture ? "selected" : "")" onclick="changeLang('@lang.Code')">
                        <span class="lang-flag">@lang.Flag</span>
                        <span class="lang-name">@lang.NativeName</span>
                        @if (lang.Code == T.CurrentCulture)
                        {
                            <span class="lang-check">✓</span>
                        }
                    </a>
                }
            </div>
        </div>
    </div>
</header>
<main class="page">
    @RenderBody()
</main>
<footer class="bottombar">
    <div class="inner">
        <span>ELX11 (Evolution Legacy X 11) &middot; @T["Footer_FanServer"] @title &middot; @T["Footer_PoweredBy"]</span>
        <span class="hints">
            <a href="/survey"><i class="dot blue"></i>Hardware Survey</a>
            <a href="/#roadmap"><i class="dot yellow"></i>Roadmap</a>
            <a href="/register"><i class="dot green"></i>@T["Footer_CreateAccount"]</a>
            <a href="#"><i class="dot red"></i>@T["Footer_BackToTop"]</a>
        </span>
    </div>
</footer>
@if (ViewData["Live"] is true)
{
    <script src="/js/live.js" asp-append-version="true" defer></script>
}
@await RenderSectionAsync("Scripts", required: false)
<script>
function toggleLangMenu(e) {
    e.stopPropagation();
    const menu = document.getElementById('langMenu');
    if (menu) menu.classList.toggle('open');
}
function changeLang(code) {
    document.cookie = "lang=" + code + ";path=/;max-age=31536000;SameSite=Lax";
    document.cookie = ".AspNetCore.Culture=c=" + code + "|uic=" + code + ";path=/;max-age=31536000;SameSite=Lax";
    const url = new URL(window.location.href);
    url.searchParams.set('lang', code);
    window.location.href = url.toString();
}
// Clean up ?lang from address bar once page has rendered with cookies
if (window.location.search.includes('lang=')) {
    const cleanUrl = new URL(window.location.href);
    cleanUrl.searchParams.delete('lang');
    window.history.replaceState(null, '', cleanUrl.pathname + cleanUrl.search + cleanUrl.hash);
}
document.addEventListener('click', function(e) {
    const menu = document.getElementById('langMenu');
    if (menu && menu.classList.contains('open')) {
        menu.classList.remove('open');
    }
});
</script>
</body>
</html>
