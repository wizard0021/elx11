@model Pager
@if (Model.Pages > 1 || Model.SizeHref is not null)
{
    <nav class="pager" aria-label="Pages">
        @if (Model.Pages > 1)
        {
            @if (Model.Page > 1)
            {
                <a href="@Model.Href(Model.Page - 1)" aria-label="@T["Pager_Prev"]">&lsaquo;</a>
            }
            @foreach (var n in Model.Numbers())
            {
                if (n == 0)
                {
                    <span class="gap">&hellip;</span>
                }
                else if (n == Model.Page)
                {
                    <span aria-current="page">@n</span>
                }
                else
                {
                    <a href="@Model.Href(n)">@n</a>
                }
            }
            @if (Model.Page < Model.Pages)
            {
                <a href="@Model.Href(Model.Page + 1)" aria-label="@T["Pager_Next"]">&rsaquo;</a>
            }
        }
        @if (Model.SizeHref is { } sizeHref)
        {
            <span class="sizes">@T["Pager_PerPage"]
                @foreach (var size in SiteData.PageSizes)
                {
                    <a href="@sizeHref(size)" aria-current="@(size == Model.Size ? "true" : null)">@size</a>
                }
            </span>
        }
    </nav>
}
