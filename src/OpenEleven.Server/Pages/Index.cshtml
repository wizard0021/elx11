@page "/"
@model IndexModel
@using OpenEleven.Server.Configuration
@inject GameProfile Game
@{
    ViewData["Nav"] = "home";
    ViewData["Live"] = true;   // sections marked data-live refresh themselves (wwwroot/js/live.js)
    var name = TitleProfiles.DisplayName(Game).Split(' ');   // "PES", "2011", "(PC)"
}
<section class="hero-stage">
    <div class="hero-char noyno" aria-hidden="true">
        <img src="/img/noyno.png" alt="Noyno - ELX11 Mascot" />
    </div>
    <div class="hero">
        <div class="stars" aria-hidden="true">★★★★★★★★★★★</div>
        <div class="hero-logo-box">
            <img src="/img/logomain_crop.png" alt="ELX11 - Evolution Legacy X 11" class="hero-main-logo" style="max-width: min(460px, 90%); height: auto; display: block; margin: 10px auto 16px;" />
        </div>
        <p class="tagline">PES 2011 online multiplayer nostalgia is back. Free, ad-free, fan-powered.</p>
        @if (Model.Announcement.Length > 0)
        {
            <p class="announcement">@Model.Announcement</p>
        }
        <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
            <a class="button hero-btn" href="/register">Create an account</a>
            <a class="button hero-btn" href="/ELX11_Launcher_v2.exe" style="background: #10b981; border-color: #10b981;">&#x2B07; Download Launcher</a>
            <a class="button hero-btn" href="https://discord.gg/2yaF3JBA5X" target="_blank" rel="noopener" style="background: #5865F2; border-color: #5865F2;">Join Discord</a>
        </div>
    </div>
    <div class="hero-char messi" aria-hidden="true">
        <img src="/img/messi.png" alt="Lionel Messi" />
    </div>
</section>

<div class="tiles" id="totals" data-live>
    <a class="tile selected" href="/players"><strong>@Model.Online</strong><span>Online now</span></a>
    <a class="tile" href="#live"><strong>@Model.Live.Count</strong><span>Playing now</span></a>
    <a class="tile" href="/players"><strong>@Model.Players</strong><span>Players</span></a>
    <a class="tile" href="/matches"><strong>@Model.Matches</strong><span>Matches</span></a>
</div>

<div class="grid two">
    <section class="panel" id="live" data-live>
        <h2><span class="online"></span>Live matches</h2>
        @if (Model.Live.Count == 0)
        {
            <p class="empty">Nobody is playing right now.</p>
        }
        else
        {
            <table class="list">
                <tbody>
                @foreach (var m in Model.Live)
                {
                    <tr>
                        <td class="num">
                            <span>@m.Home</span>
                            <span class="platform-badges">
                                <img src="/img/@(m.HomePlatform.Contains("PS3", StringComparison.OrdinalIgnoreCase) ? "ps3_white.png" : "pc.png")" alt="@m.HomePlatform" title="@m.HomePlatform" class="platform-icon" />
                            </span>
                        </td>
                        <td class="center score">
                            <div class="live-platforms-center">
                                <img src="/img/@(m.HomePlatform.Contains("PS3", StringComparison.OrdinalIgnoreCase) ? "ps3_white.png" : "pc.png")" alt="@m.HomePlatform" title="@m.HomePlatform" class="platform-icon" />
                                <span class="vs-badge">VS</span>
                                <img src="/img/@(m.AwayPlatform.Contains("PS3", StringComparison.OrdinalIgnoreCase) ? "ps3_white.png" : "pc.png")" alt="@m.AwayPlatform" title="@m.AwayPlatform" class="platform-icon" />
                            </div>
                            <span>@m.HomeGoals &ndash; @m.AwayGoals</span>
                        </td>
                        <td>
                            <span class="platform-badges" style="margin-left: 0; margin-right: 6px;">
                                <img src="/img/@(m.AwayPlatform.Contains("PS3", StringComparison.OrdinalIgnoreCase) ? "ps3_white.png" : "pc.png")" alt="@m.AwayPlatform" title="@m.AwayPlatform" class="platform-icon" />
                            </span>
                            <span>@m.Away</span>
                        </td>
                        <td class="num"><span class="tag lime">@m.Phase</span></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section class="panel">
        <header>Top players <a href="/rankings">Rankings &rsaquo;</a></header>
        @if (Model.Top.Count == 0)
        {
            <p class="empty">No ranked players yet.</p>
        }
        else
        {
            <table class="list">
                <tbody>
                @for (var i = 0; i < Model.Top.Count; i++)
                {
                    var p = Model.Top[i];
                    <tr>
                        <td class="num muted">@(i + 1)</td>
                        <td>
                            <a href="/players/@p.Pid">@p.Name</a>
                            <span class="platform-badges">
                                @if (p.Platforms.Contains("PC", StringComparison.OrdinalIgnoreCase))
                                {
                                    <img src="/img/pc.png" alt="PC" title="PC" class="platform-icon" />
                                }
                                @if (p.Platforms.Contains("PS3", StringComparison.OrdinalIgnoreCase))
                                {
                                    <img src="/img/ps3_white.png" alt="PS3" title="PS3" class="platform-icon" />
                                }
                            </span>
                        </td>
                        @if (Model.Ranked)
                        {
                            <td><span class="div @p.Division">@p.Division</span></td>
                            <td class="num score">@p.Rating</td>
                        }
                        else
                        {
                            <td class="num score">@p.Wins W</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
</div>

<hr class="rule">

<div class="grid two">
    <section class="panel" id="latest" data-live>
        <header>Latest matches <a href="/matches">All matches &rsaquo;</a></header>
        <partial name="_Matches" model="Model.Recent" />
    </section>

    <section class="panel" id="news" data-live>
        <h2>News</h2>
        @if (Model.News.Count == 0)
        {
            <p class="empty">No news.</p>
        }
        else
        {
            <table class="list">
                <tbody>
                @foreach (var n in Model.News)
                {
                    <tr>
                        <td style="white-space: normal">
                            <button type="button" class="linkbutton" popovertarget="news-@n.Id">@n.Subject</button>
                            @if (n.Important) { <span class="tag red">Important</span> }
                        </td>
                        <td class="num muted">@n.PublishedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
                </tbody>
            </table>
            @foreach (var n in Model.News)
            {
                <div id="news-@n.Id" popover class="modal" role="dialog" aria-label="@n.Subject">
                    <header>
                        <span>@n.PublishedAt.ToString("yyyy-MM-dd")</span>
                        @if (n.Important) { <span class="tag red">Important</span> }
                        <button type="button" class="close" popovertarget="news-@n.Id" popovertargetaction="hide" aria-label="Close">&times;</button>
                    </header>
                    <h3>@n.Subject</h3>
                    <p class="newsbody">@n.Body</p>
                </div>
            }
        }
    </section>
</div>


<hr class="rule">

<section class="panel roadmap-section" id="roadmap">
    <div class="roadmap-header-row" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
        <div>
            <h2 style="margin: 0 0 6px;"><span class="online"></span>ELX11 Project Roadmap</h2>
            <p class="muted" style="margin: 0; font-size: 13.5px;">Evolution Legacy X 11 development milestones, open beta and future vision.</p>
        </div>
        <span class="tag lime" style="font-size: 11.5px; padding: 4px 10px; font-weight: 700; letter-spacing: 0.05em;">● OPEN BETA ACTIVE</span>
    </div>

    <div class="roadmap-grid">
        <div class="roadmap-card">
            <div class="phase-header">
                <span class="phase-tag completed">✓ Phase 1 &middot; Core</span>
                <span class="phase-status-text" style="color: #34d399; font-size: 11px; font-weight: 600;">Completed</span>
            </div>
            <h3>Core Infrastructure</h3>
            <p class="desc">Reverse-engineered Konami binary protocol and server backbone built from scratch in .NET 9.</p>
            <ul class="roadmap-items">
                <li><span class="check" style="color: #34d399;">✔</span> <span>XOR & Blowfish-ECB cryptography and packet framing</span></li>
                <li><span class="check" style="color: #34d399;">✔</span> <span>Gate, Account, Menu & Lobby services (.NET 9)</span></li>
                <li><span class="check" style="color: #34d399;">✔</span> <span>Web Hub, Konami ID-style registration & account system</span></li>
                <li><span class="check" style="color: #34d399;">✔</span> <span>UDP P2P Direct Handshake (Port 5730) integration</span></li>
            </ul>
        </div>

        <div class="roadmap-card active">
            <div class="phase-header">
                <span class="phase-tag active">★ Phase 2 &middot; Open Beta</span>
                <span class="phase-status-text" style="color: var(--lime); font-size: 11px; font-weight: 700;">Live Now</span>
            </div>
            <h3>Cross-Platform & Beta</h3>
            <p class="desc">Open beta is now live, bringing PC and PlayStation 3 players together on the same server!</p>
            <ul class="roadmap-items">
                <li><span class="check" style="color: var(--lime);">✔</span> <span><strong>Dual-Platform:</strong> PC & PS3 players in the same lobby</span></li>
                <li><span class="check" style="color: var(--lime);">✔</span> <span>Dynamic platform indicator badges on live matches & profiles</span></li>
                <li><span class="check" style="color: var(--lime);">✔</span> <span>ELX11 Launcher v2: Automated setup, DNS config & self-update</span></li>
                <li><span class="check" style="color: var(--lime);">✔</span> <span>Public open registration & real-time Live Match Ticker</span></li>
            </ul>
        </div>

        <div class="roadmap-card">
            <div class="phase-header">
                <span class="phase-tag in-progress">⚡ Phase 3 &middot; Next</span>
                <span class="phase-status-text" style="color: #38bdf8; font-size: 11px; font-weight: 600;">In Progress</span>
            </div>
            <h3>Matchmaking & Cups</h3>
            <p class="desc">Automated skill-based matchmaking algorithms and official tournament bracket engine.</p>
            <ul class="roadmap-items">
                <li><span class="check" style="color: #38bdf8;">🔄</span> <span>Elo / Rating-based <strong>Quick Match</strong> automated matchmaking queue</span></li>
                <li><span class="check" style="color: #38bdf8;">🔄</span> <span>Automated Weekend Knockout Cups & community tournaments</span></li>
                <li><span class="check" style="color: #38bdf8;">🔄</span> <span>RPCS3 PS3 Emulator network synchronization & latency tuning</span></li>
                <li><span class="check" style="color: #38bdf8;">🔄</span> <span>Anti-ragequit penalty system & disconnect handling</span></li>
            </ul>
        </div>

        <div class="roadmap-card">
            <div class="phase-header">
                <span class="phase-tag planned">✦ Phase 4 &middot; Vision</span>
                <span class="phase-status-text" style="color: #c084fc; font-size: 11px; font-weight: 600;">Planned</span>
            </div>
            <h3>Master League Online</h3>
            <p class="desc">The heartbeat of PES 2011: Full revival of the legendary Master League Online ecosystem.</p>
            <ul class="roadmap-items">
                <li><span class="check" style="color: #c084fc;">📋</span> <span><strong>Master League Online (MLO):</strong> Squad building & player contracts</span></li>
                <li><span class="check" style="color: #c084fc;">📋</span> <span>Dynamic peer-to-peer transfer market & club budget management</span></li>
                <li><span class="check" style="color: #c084fc;">📋</span> <span>Monthly Community Hardware & Telemetry Surveys</span></li>
            </ul>
        </div>
    </div>
</section>
