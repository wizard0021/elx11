@page "/rankings"
@model RankingsModel
@using OpenEleven.Server.State
@{
    ViewData["Title"] = "Rankings";
    ViewData["Nav"] = "rankings";
    string? On(bool selected) => selected ? "true" : null;
}
<h1 class="title">@T["Rankings_Title"]</h1>

<nav class="tabs" aria-label="Period">
    <a href="@RankingsModel.Link(Model.Sort, false, Model.Division)" aria-current="@On(!Model.Week)">@T["Tabs_AllTime"]</a>
    <a href="@RankingsModel.Link(Model.Sort, true, Model.Division)" aria-current="@On(Model.Week)">@T["Tabs_ThisWeek"]</a>
</nav>
<nav class="tabs" aria-label="Sort">
    @foreach (var t in Model.Shown)
    {
        <a href="@RankingsModel.Link(t.Key, Model.Week, Model.Division)" aria-current="@On(t.Key == Model.Sort)">@t.Label</a>
    }
</nav>
@if (Model.Ranked)
{
    <nav class="tabs" aria-label="Division">
        <a href="@RankingsModel.Link(Model.Sort, Model.Week, null)" aria-current="@On(Model.Division is null)">@T["Tabs_AllDivisions"]</a>
        @foreach (var d in Enumerable.Reverse(RankSystem.Divisions))
        {
            <a href="@RankingsModel.Link(Model.Sort, Model.Week, d)" aria-current="@On(d == Model.Division)">@d</a>
        }
    </nav>
}

<section class="panel">
    @if (Model.Lines.Count == 0)
    {
        <p class="empty">@(Model.Week ? T["Rankings_EmptyWeek"] : T["Rankings_EmptyAll"])</p>
    }
    else
    {
        <div class="scroll">
            <table class="list">
                <thead>
                <tr>
                    <th class="num">#</th><th>@T["Col_Player"]</th>
                    @if (Model.Ranked) { <th>@T["Col_Division"]</th><th class="num">@T["Col_Rating"]</th><th class="num">@T["Col_Points"]</th> }
                    <th class="num">@T["Col_MatchesShort"]</th><th class="num">@T["Col_WinShort"]</th><th class="num">@T["Col_DrawShort"]</th><th class="num">@T["Col_LossShort"]</th>
                    <th class="num">@T["Col_WinRate"]</th><th class="num">@T["Col_Streak"]</th>
                </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    var l = Model.Lines[i];
                    <tr>
                        <td class="num muted">@(Model.First + i + 1)</td>
                        <td>
                            @if (Model.Online.Contains(l.Pid)) { <span class="online" title="Online"></span> }<a href="/players/@l.Pid">@l.Name</a>
                            <span class="platform-badges">
                                @if (l.Platforms.Contains("PC", StringComparison.OrdinalIgnoreCase))
                                {
                                    <img src="/img/pc.png" alt="PC" title="PC" class="platform-icon" />
                                }
                                @if (l.Platforms.Contains("PS3", StringComparison.OrdinalIgnoreCase))
                                {
                                    <img src="/img/ps3_white.png" alt="PS3" title="PS3" class="platform-icon" />
                                }
                            </span>
                        </td>
                        @if (Model.Ranked)
                        {
                            <td><span class="div @l.Division">@l.Division</span></td>
                            <td class="num score">@l.Rating</td>
                            <td class="num">@l.Value</td>
                        }
                        <td class="num">@l.Matches</td>
                        <td class="num">@l.Wins</td>
                        <td class="num">@l.Draws</td>
                        <td class="num">@l.Losses</td>
                        <td class="num">@SiteData.WinPercent(l.Wins, l.Matches)</td>
                        <td class="num">@l.Streak</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
<partial name="_Pager" model="Model.Pager" />
