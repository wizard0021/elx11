@page "/players/{id}"
@model PlayerModel
@{
    var name = Model.DisplayName;
    ViewData["Title"] = name;
    ViewData["Nav"] = "players";
}
<div class="profile-head">
    <div class="profile-title-row" style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <h1 class="title" style="margin-bottom: 0;">@name</h1>
        <div class="platform-badges" style="display: inline-flex; align-items: center; gap: 6px;">
            @{
                var platforms = Model.Account?.Platforms ?? Model.Profile?.Account?.Platforms ?? "PC";
            }
            @if (platforms.Contains("PC", StringComparison.OrdinalIgnoreCase))
            {
                <img src="/img/pc.png" alt="PC" title="PC Platform" class="platform-icon lg" />
            }
            @if (platforms.Contains("PS3", StringComparison.OrdinalIgnoreCase))
            {
                <img src="/img/ps3_white.png" alt="PS3" title="PlayStation 3 Platform" class="platform-icon lg" />
            }
        </div>
        @if (Model.Profile is { } prof && Model.Ranked)
        {
            <span class="div @prof.Division">@prof.Division</span>
        }
        @if (Model.IsOnline)
        {
            <span class="tag lime"><span class="online"></span>@T["Profile_OnlineNow"]</span>
        }
        else
        {
            <span class="tag muted" style="border-color: rgba(255,255,255,.15);"><span class="offline-dot"></span>@T["Profile_Offline"] (@Model.LastSeenText)</span>
        }
    </div>
    <span class="muted" style="display: block; margin-top: 6px;">
        @T["Profile_MemberSince"] @Model.MemberSince.ToString("yyyy-MM-dd")
        @if (Model.Profile?.LastPlayedAt is { } at)
        {
            <text>&middot; @T["Profile_LastPlayed"]: @SiteData.TimeAgo(at) (@SiteData.Date(at) UTC)</text>
        }
    </span>
</div>

@if (Model.Profile is { } p)
{
    var s = p.Stats;
    <section class="panel">
        <div class="stats">
            @if (Model.Ranked)
            {
                <div class="stat"><strong>@p.Rating</strong><span>@T["Stat_Rating"]</span></div>
                <div class="stat"><strong>@(p.Rank > 0 ? $"#{p.Rank}" : "Unranked")</strong><span>@T["Stat_RankPosition"]</span></div>
                <div class="stat"><strong>@p.Point</strong><span>@T["Stat_Points"]</span></div>
                <div class="stat"><strong>@p.SeasonPoints</strong><span>@T["Stat_SeasonPts"]</span></div>
                <div class="stat"><strong>@p.WeeklyPoints</strong><span>@T["Stat_WeekPts"]</span></div>
            }
            <div class="stat"><strong>@s.MatchCount</strong><span>@T["Stat_Matches"]</span></div>
            <div class="stat"><strong>@s.WinCount</strong><span>@T["Stat_Wins"]</span></div>
            <div class="stat"><strong>@s.DrawCount</strong><span>@T["Stat_Draws"]</span></div>
            <div class="stat"><strong>@s.LoseCount</strong><span>@T["Stat_Losses"]</span></div>
            <div class="stat"><strong>@SiteData.WinPercent(s.WinCount, s.MatchCount)</strong><span>@T["Stat_WinRate"]</span></div>
            <div class="stat"><strong>@s.Goals</strong><span>@T["Stat_GoalsFor"]</span></div>
            <div class="stat"><strong>@s.GoalsAgainst</strong><span>@T["Stat_GoalsAgainst"]</span></div>
            <div class="stat"><strong>@s.ContinuousWins</strong><span>Win streak</span></div>
            <div class="stat"><strong>@s.MaxContinuousWins</strong><span>@T["Stat_BestStreak"]</span></div>
            <div class="stat"><strong>@s.DisconnectCount</strong><span>@T["Stat_Disconnects"]</span></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(p.Intro))
        {
            <p class="intro">&ldquo;@p.Intro&rdquo;</p>
        }
    </section>

    <hr class="rule">

    <section class="panel">
        <h2>Recent matches</h2>
        @if (Model.Recent.Count == 0)
        {
            <p class="empty" style="padding: 16px;">No matches played yet.</p>
        }
        else
        {
            <partial name="_Matches" model="Model.Recent" />
        }
    </section>
}
else
{
    <section class="panel" style="margin-top: 18px;">
        <div class="body" style="padding: 32px 20px; text-align: center;">
            <div style="font-size: 44px; margin-bottom: 12px;">⚽</div>
            <h2 style="margin-bottom: 10px; font-size: 20px;">ELX11 Account Active!</h2>
            <p class="muted" style="max-width: 520px; margin: 0 auto 20px; font-size: 14px; line-height: 1.6;">
                The account <strong>@name</strong> has been successfully registered. Once you log in to the PES 2011 game client with this Game ID and confirm your player name, your division rank, win rates, goal stats, and match history will be displayed here automatically.
            </p>
            <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
                <span class="tag lime">Account Status: Active</span>
                <span class="tag">First In-Game Login: Pending</span>
            </div>
        </div>
    </section>
}
